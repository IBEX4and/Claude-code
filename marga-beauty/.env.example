# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Sem as três variáveis do Google, o agendamento roda em modo demonstração.

# Endereço final do site (usado nas prévias de link do WhatsApp/Instagram)
NEXT_PUBLIC_SITE_URL=https://margabrazilianbeauty.com

# Conta de serviço do Google Cloud (veja o README, seção "Google Agenda")
GOOGLE_SERVICE_ACCOUNT_EMAIL=agenda-site@seu-projeto.iam.gserviceaccount.com
# Cole a chave inteira entre aspas, com os \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID da agenda da Marga (Configurações da agenda > Integrar agenda > ID da agenda)
GOOGLE_CALENDAR_ID=marga@gmail.com

# Opcional: outras agendas que também bloqueiam horários (ex.: pessoal), separadas por vírgula
GOOGLE_EXTRA_BUSY_CALENDAR_IDS=
